---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Sunny Furniture by Deelert Woodline',
	url: 'https://catalog.sunny.co.th',
	logo: 'https://catalog.sunny.co.th/images/hero/wardrobe-solid-oak.jpg',
	email: 'deelert@sunny.co.th',
	telephone: '+66-34-852-188',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '51/7 Moo 3, Ekkachai Road, Bang Nam Chuet',
		addressLocality: 'Mueang Samut Sakhon',
		postalCode: '74000',
		addressCountry: 'TH',
	},
};
---

<!doctype html>
<html lang="th">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero wrap">
				<div class="hero-copy">
					<p class="eyebrow">DEELERT WOODLINE · SINCE 1990</p>
					<h1>โรงงานผลิตและขายส่ง<wbr />เฟอร์นิเจอร์น็อคดาวน์</h1>
					<p class="lead">Sunny Furniture รับผลิตเฟอร์นิเจอร์ไม้ปาร์ติเกิลและ MDF สำหรับร้านค้า หอพัก อพาร์ตเมนต์ คอนโด และโครงการธุรกิจ พร้อมบริการ OEM และส่งออก</p>
					<div class="actions">
						<a class="button" href="#contact">ขอใบเสนอราคา</a>
						<a class="text-link" href="#products">ดูประเภทสินค้า <span aria-hidden="true">→</span></a>
					</div>
					<ul class="trust-list" aria-label="จุดเด่นของ Sunny Furniture">
						<li>ผลิตตามแบบสำหรับคำสั่งซื้อ 60+ ชิ้นต่อแบบ</li>
						<li>ประสบการณ์ผลิตเฟอร์นิเจอร์กว่า 30 ปี</li>
						<li>บริการลูกค้าในไทยและตลาดส่งออก</li>
					</ul>
				</div>
				<div class="hero-showcase" aria-label="สินค้าจากโรงงาน Sunny Furniture">
					<a href="/products/d6122"><img src="/images/hero/wardrobe-solid-oak.jpg" width="1000" height="1000" alt="ตู้เสื้อผ้า D6122" fetchpriority="high" /><span>ตู้เสื้อผ้า D6122</span></a>
					<a href="/products/b5058"><img src="/images/catalog/b5058/1.webp" width="800" height="800" alt="เตียงนอนรุ่น B5058" loading="eager" /><span>เตียงนอน B5058</span></a>
					<a href="/products/b5111"><img src="/images/catalog/b5111/1.webp" width="800" height="800" alt="เตียงนอนรุ่น B5111" loading="eager" /><span>เตียงนอน B5111</span></a>
					<a href="/products/b5112"><img src="/images/catalog/b5112/1.webp" width="800" height="800" alt="เตียงนอนรุ่น B5112" loading="eager" /><span>เตียงนอน B5112</span></a>
				</div>
			</section>

			<section class="search-intent wrap" aria-label="ประเภทเฟอร์นิเจอร์ที่ Sunny Furniture ผลิต">
				<a href="/products?filter=wardrobe"><strong>ตู้เสื้อผ้า</strong><span>สำหรับบ้าน หอพัก และอพาร์ตเมนต์</span></a>
				<a href="/products?filter=bed"><strong>เตียงนอน</strong><span>เตียงไม้และชุดห้องนอนหลายขนาด</span></a>
				<a href="/products"><strong>เฟอร์นิเจอร์ราคาโรงงาน</strong><span>ตู้วางทีวี ตู้เก็บของ และงานโครงการ</span></a>
			</section>

			<section id="products" class="section wrap">
				<p class="eyebrow">PRODUCT RANGE</p>
				<h2>เฟอร์นิเจอร์สำหรับบ้านและโครงการ</h2>
				<p class="section-intro">เลือกผลิตภัณฑ์มาตรฐานสำหรับขายส่ง หรือให้ทีมโรงงานออกแบบชุดเฟอร์นิเจอร์ตามพื้นที่และกลุ่มลูกค้าของคุณ</p>
				<div class="product-grid">
					<article class="product-card featured">
						<img src="/images/hero/wardrobe-solid-oak.jpg" width="1000" height="1000" loading="lazy" alt="ตู้เสื้อผ้า D6122 Sunny Furniture" />
						<div><p class="card-label">WARDROBE</p><h3>ตู้เสื้อผ้าและตู้เก็บของ</h3><p>ตอบโจทย์ร้านเฟอร์นิเจอร์ หอพัก และโครงการที่ต้องการพื้นที่จัดเก็บอย่างเป็นระเบียบ</p><a href="/products/d4901">ดูรุ่น D4901 →</a></div>
					</article>
					<article class="product-card"><img src="/images/b5012-bed-detail.png" width="1024" height="1024" loading="lazy" alt="รายละเอียดหัวเตียงไม้ของ Sunny Furniture รุ่น B5012" /><div><p class="card-label">BEDROOM</p><h3>เตียงและชุดห้องนอน</h3><p>ชุดเฟอร์นิเจอร์ที่ออกแบบเพื่อการใช้งานจริงในบ้าน คอนโด และธุรกิจที่พัก</p></div></article>
				</div>
			</section>

			<section id="oem" class="oem-section">
				<div class="wrap oem-grid">
					<div><p class="eyebrow">OEM & WHOLESALE</p><h2>มีแบบอยู่แล้ว? ให้โรงงานช่วยผลิต</h2></div>
					<div><p>ส่งแบบ ขนาด จำนวน และปลายทางจัดส่งให้เรา ทีม Sunny Furniture จะช่วยประเมินแนวทางผลิตที่เหมาะกับงานของคุณ ตั้งแต่การเลือกวัสดุไปจนถึงแผนส่งมอบ</p><p>เหมาะสำหรับผู้ค้าส่ง โครงการที่พัก ผู้รับเหมา และแบรนด์ที่ต้องการสินค้าภายใต้ชื่อของตนเอง</p><a class="button button-light" href="#contact">เริ่มขอราคา OEM</a></div>
				</div>
			</section>

			<section class="section wrap proof-section">
				<p class="eyebrow">WHY SUNNY</p><h2>ทำงานกับโรงงานโดยตรง</h2>
				<div class="proof-grid"><div><strong>30+ ปี</strong><span>ประสบการณ์ในการผลิต</span></div><div><strong>60+ ชิ้น</strong><span>ขั้นต่ำโดยทั่วไปสำหรับงาน OEM ต่อแบบ</span></div><div><strong>TH + EXPORT</strong><span>รองรับลูกค้าในประเทศและต่างประเทศ</span></div></div>
			</section>

			<section id="contact" class="contact-section">
				<div class="wrap contact-grid"><div><p class="eyebrow">REQUEST A QUOTE</p><h2>คุยกับทีมขายส่งของเรา</h2><p>บอกประเภทสินค้า จำนวนที่ต้องการ และสถานที่จัดส่ง เพื่อให้เราเตรียมคำแนะนำและใบเสนอราคาได้ตรงความต้องการ</p></div><address><p><strong>โทรศัพท์</strong><br /><a href="tel:+6634852188">034-852-188</a> · <a href="tel:+66958688777">095-868-8777</a></p><p><strong>อีเมล</strong><br /><a href="mailto:deelert@sunny.co.th">deelert@sunny.co.th</a></p><p><strong>โรงงาน</strong><br />51/7 หมู่ 3 ถนนเอกชัย<br />ตำบลบางน้ำจืด อำเภอเมืองสมุทรสาคร 74000</p></address></div>
			</section>
		</main>
		<Footer />
	</body>
</html>
