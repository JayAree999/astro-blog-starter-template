			['ชั้นวางของราคาถูก', '/categories/storage-and-shoe-cabinets/'],
			['ตู้ลิ้นชัก', '/categories/storage-and-shoe-cabinets/'],
		],
	},
	{
		title: 'แต่งห้องตามสไตล์',
		items: [
			['เฟอร์นิเจอร์มินิมอล', '/products'],
			['เฟอร์นิเจอร์โมเดิร์น', '/products'],
			['เฟอร์นิเจอร์สีขาว', '/products'],
