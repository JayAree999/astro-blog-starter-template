			['รับผลิตเฟอร์นิเจอร์ตามแบบ', '/#oem'],
			['รับผลิตเฟอร์นิเจอร์ไม้ตามแบบ', '/#oem'],
			['รับผลิตตู้เสื้อผ้าตามแบบ', '/#oem'],
			['รับผลิตเตียงนอนตามแบบ', '/#oem'],
			['ผลิตเฟอร์นิเจอร์แบรนด์ลูกค้า', '/#oem'],
			['โรงงานเฟอร์นิเจอร์ส่งออก', '/#oem'],
		],
	},
] as const;

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Sunny Furniture by Deelert Woodline',
	url: 'https://catalog.sunny.co.th',
	logo: 'https://catalog.sunny.co.th/images/brand/sunny-furniture-logo.png',
	email: 'jayyqwe123@gmail.com',
	telephone: '+66-34-852-188',
	contactPoint: [
		{ '@type': 'ContactPoint', telephone: '+66-34-852-188', contactType: 'sales', areaServed: 'TH', availableLanguage: ['th', 'en'] },
		{ '@type': 'ContactPoint', telephone: '+66-95-868-8777', contactType: 'sales', areaServed: 'TH', availableLanguage: ['th', 'en'] },
		{ '@type': 'ContactPoint', telephone: '+66-95-557-7768', contactType: 'sales', areaServed: 'TH', availableLanguage: ['th', 'en'] },
	],
	hasMap: 'https://maps.app.goo.gl/1yb3cMqZEDYQAFbU8',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '51/7 Moo 3, Ekkachai Road, Bang Nam Chuet',
		addressLocality: 'Mueang Samut Sakhon',
		postalCode: '74000',
		addressCountry: 'TH',
	},
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Sunny Furniture',
	alternateName: ['SUNNY', 'SUNNY Catalog', 'catalog.sunny.co.th'],
	url: 'https://catalog.sunny.co.th/',
};
---

<!doctype html>
<html lang="th">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero wrap">
				<div class="hero-copy">
					<p class="eyebrow">SUNNY CATALOG · DEELERT WOODLINE · SINCE 1990</p>
					<h1>ตู้เสื้อผ้า เตียงนอน และเฟอร์นิเจอร์ SUNNY<wbr /> ราคาโรงงาน</h1>
					<p class="lead">เลือกดู SUNNY Catalog จากโรงงานผู้ผลิตเฟอร์นิเจอร์ไม้ปาร์ติเกิลและ MDF รวมตู้เสื้อผ้า เตียงนอน ตู้ทีวี และตู้เก็บของ สำหรับร้านค้า หอพัก อพาร์ตเมนต์ คอนโด และโครงการ พร้อมบริการขายส่ง OEM และส่งออก</p>
					<div class="actions">
						<a class="button" href="#contact">ขอใบเสนอราคา</a>
						<a class="text-link" href="#products">ดูประเภทสินค้า <span aria-hidden="true">→</span></a>
					</div>
					<ul class="trust-list" aria-label="จุดเด่นของ Sunny Furniture">
						<li>ผลิตตามแบบสำหรับคำสั่งซื้อ 60–70+ ชิ้นต่อแบบ</li>
						<li>ประสบการณ์ผลิตเฟอร์นิเจอร์กว่า 30 ปี</li>
						<li>บริการลูกค้าและร้านค้าในประเทศไทย</li>
					</ul>
				</div>
				<div class="hero-showcase" aria-label="สินค้าจากโรงงาน Sunny Furniture">
					<a href="/products/d6122"><img src="/images/hero/wardrobe-solid-oak.jpg" width="1000" height="1000" alt="ตู้เสื้อผ้า D6122" fetchpriority="high" /><span>ตู้เสื้อผ้า D6122</span></a>
					<a href="/products/b5058"><img src="/images/catalog/b5058/1.webp" width="800" height="800" alt="เตียงนอนรุ่น B5058" loading="eager" /><span>เตียงนอน B5058</span></a>
					<a href="/products/b5111"><img src="/images/catalog/b5111/1.webp" width="800" height="800" alt="เตียงนอนรุ่น B5111" loading="eager" /><span>เตียงนอน B5111</span></a>
					<a href="/products/b5112"><img src="/images/catalog/b5112/1.webp" width="800" height="800" alt="เตียงนอนรุ่น B5112" loading="eager" /><span>เตียงนอน B5112</span></a>
				</div>
			</section>

			<section class="search-intent wrap" aria-label="ประเภทเฟอร์นิเจอร์ที่ Sunny Furniture ผลิต">
				<a href="/products?filter=wardrobe"><strong>ตู้เสื้อผ้า</strong><span>สำหรับบ้าน หอพัก และอพาร์ตเมนต์</span></a>
				<a href="/products?filter=bed"><strong>เตียงนอน</strong><span>เตียงไม้และชุดห้องนอนหลายขนาด</span></a>
				<a href="/products"><strong>เฟอร์นิเจอร์ราคาโรงงาน</strong><span>ตู้วางทีวี ตู้เก็บของ และงานโครงการ</span></a>
			</section>

			<section class="popular-searches wrap" aria-labelledby="popular-searches-title">
				<div class="popular-searches-heading">
					<p class="eyebrow">POPULAR FURNITURE SEARCHES</p>
					<h2 id="popular-searches-title">เลือกเฟอร์นิเจอร์ตามสินค้า พื้นที่ และงบประมาณ</h2>
					<p>รวมทางลัดสำหรับค้นหาตู้เสื้อผ้า เตียงนอน ตู้วางทีวี ตู้เก็บของ เฟอร์นิเจอร์หอพัก งานขายส่ง และงานผลิต OEM จากแคตตาล็อก SUNNY Furniture</p>
				</div>
				<div class="popular-search-grid">
					{popularSearchGroups.map((group) => (
						<article class="popular-search-group">
							<h3>{group.title}</h3>
							<ul>{group.items.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
						</article>
					))}
				</div>
			</section>

			<section id="products" class="section wrap">
				<p class="eyebrow">PRODUCT RANGE</p>
				<h2>เฟอร์นิเจอร์สำหรับบ้านและโครงการ</h2>
				<p class="section-intro">เลือกผลิตภัณฑ์มาตรฐานสำหรับขายส่ง หรือให้ทีมโรงงานออกแบบชุดเฟอร์นิเจอร์ตามพื้นที่และกลุ่มลูกค้าของคุณ</p>
				<div class="product-grid featured-product-grid">
					{featuredProducts.map((product) => <article class="product-card"><img src={product.image} width="800" height="800" loading="lazy" alt={product.gallery[0].alt} /><div><p class="card-label">{product.model.startsWith('D') ? 'WARDROBE' : 'BEDROOM'} · รุ่น {product.model}</p><h3>{product.shortName}</h3><a href={`/products/${product.slug}`}>ดูรายละเอียดสินค้า <span aria-hidden="true">→</span></a></div></article>)}
				</div>
				<p class="featured-products-action"><a class="button" href="/products">ดูแคตตาล็อกและสินค้าทั้งหมด</a></p>
			</section>

			<section id="oem" class="oem-section">
				<div class="wrap oem-grid">
					<div><p class="eyebrow">OEM & WHOLESALE</p><h2>มีแบบอยู่แล้ว? ให้โรงงานช่วยผลิต</h2></div>
					<div><p>ส่งแบบ ขนาด จำนวน และปลายทางจัดส่งให้เรา ทีม Sunny Furniture จะช่วยประเมินแนวทางผลิตที่เหมาะกับงานของคุณ ตั้งแต่การเลือกวัสดุไปจนถึงแผนส่งมอบ</p><p>เหมาะสำหรับผู้ค้าส่ง โครงการที่พัก ผู้รับเหมา และแบรนด์ที่ต้องการสินค้าภายใต้ชื่อของตนเอง</p><a class="button button-light" href="#contact">เริ่มขอราคา OEM</a></div>
				</div>
			</section>

			<section class="section wrap proof-section">
				<p class="eyebrow">FURNITURE WHOLESALE</p><h2>เฟอร์นิเจอร์ราคาส่ง ราคาโรงงาน สำหรับร้านค้าและโครงการ</h2>
				<p class="section-intro">เลือกตู้เสื้อผ้า เตียงนอน และเฟอร์นิเจอร์สำหรับบ้าน หอพัก อพาร์ตเมนต์ และร้านค้า พร้อมสอบถามราคาโรงงาน ราคาส่ง และจำนวนสั่งซื้อได้ตามรุ่นสินค้า</p>
				<div class="proof-grid"><div><strong>เฟอร์นิเจอร์ราคาส่ง</strong><span>สินค้าสำหรับร้านค้า ผู้รับเหมา หอพัก และโครงการในประเทศไทย</span></div><div><strong>ตู้เสื้อผ้า · เตียงราคาถูก</strong><span>เลือกดูรุ่นตู้เสื้อผ้าและเตียงนอน พร้อมภาพสินค้าและรายละเอียด</span></div><div><strong>ราคาโรงงาน</strong><span>สอบถามราคา จำนวนขั้นต่ำ 60–70+ ชิ้น และงานผลิตตามแบบได้</span></div></div>
			</section>

			<section id="contact" class="contact-section">
				<div class="wrap contact-grid"><div><p class="eyebrow">REQUEST A QUOTE</p><h2>คุยกับทีมขายส่งของเรา</h2><p>บอกประเภทสินค้า จำนวนที่ต้องการ และสถานที่จัดส่ง เพื่อให้เราเตรียมคำแนะนำและใบเสนอราคาได้ตรงความต้องการ</p></div><address><p><strong>โทรศัพท์</strong><br /><a href="tel:+6634852188">034-852-188</a> · <a href="tel:+66958688777">095-868-8777</a> · <a href="tel:+66955577768">095-557-7768</a></p><p><strong>อีเมล</strong><br /><a href="mailto:jayyqwe123@gmail.com">jayyqwe123@gmail.com</a></p><p><strong>โรงงาน</strong><br />51/7 หมู่ 3 ถนนเอกชัย<br />ตำบลบางน้ำจืด อำเภอเมืองสมุทรสาคร 74000<br /><a href="https://maps.app.goo.gl/1yb3cMqZEDYQAFbU8" target="_blank" rel="noopener noreferrer">เปิดตำแหน่งใน Google Maps</a></p></address></div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.popular-searches{padding:4.5rem 0}.popular-searches-heading{display:grid;grid-template-columns:.75fr 1.25fr;column-gap:2rem;align-items:start}.popular-searches-heading .eyebrow{grid-column:1/-1}.popular-searches-heading h2{max-width:17ch}.popular-searches-heading>p:last-child{max-width:66ch;color:var(--muted)}.popular-search-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-top:2rem}.popular-search-group{padding:1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:14px}.popular-search-group h3{font-size:1.05rem;margin-bottom:.8rem}.popular-search-group ul{display:flex;flex-wrap:wrap;gap:.45rem;margin:0;padding:0;list-style:none}.popular-search-group a{display:inline-block;padding:.35rem .55rem;border-radius:99px;background:var(--paper);color:var(--ink);font-size:.88rem;text-decoration:none}.popular-search-group a:hover{background:var(--brand);color:#fff}@media(max-width:900px){.popular-search-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.popular-searches{padding:3.25rem 0}.popular-searches-heading{grid-template-columns:1fr}.popular-search-grid{grid-template-columns:1fr}}
</style>
