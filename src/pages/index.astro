			['ชุดห้องนอนราคาถูก', '/categories/beds/'],
		],
	},
	{
		title: 'ตู้ทีวีและห้องนั่งเล่น',
		items: [
			['ตู้วางทีวีราคาถูก', '/categories/tv-stands/'],
			['ตู้วางทีวีราคาโรงงาน', '/categories/tv-stands/'],
			['ตู้วางทีวีมินิมอล', '/categories/tv-stands/'],
