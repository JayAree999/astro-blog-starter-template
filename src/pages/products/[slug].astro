---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { catalogProducts } from '../../data/catalog';

export function getStaticPaths() {
	return catalogProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const imagePath = (path: string) => path.replace(/\.png$/, '.webp');
const title = `${product.name} | Sunny Furniture`;
const productUrl = new URL(Astro.url.pathname, Astro.site).toString();
const productSchema = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: product.name,
	description: product.description,
	image: product.gallery.map((item) => new URL(item.src, Astro.site).toString()),
	sku: product.model,
	brand: { '@type': 'Brand', name: 'Sunny Furniture' },
	category: product.category,
	material: product.material,
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'หน้าหลัก', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'แคตตาล็อกและสินค้า', item: new URL('/products/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: product.shortName, item: productUrl },
	],
};
const relatedProducts = catalogProducts.filter((item) => item.slug !== product.slug && item.category === product.category).slice(0, 3);
---

<!doctype html>
<html lang="th">
	<head>
		<BaseHead title={title} description={product.description} image={product.image} type="product" robots={product.indexable ? 'index,follow' : 'noindex,follow'} />
		<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body>
		<Header />
		<main class="product-page wrap">
			<nav class="breadcrumbs" aria-label="เส้นทางนำทาง"><a href="/">หน้าหลัก</a><span>/</span><a href="/products/">แคตตาล็อกและสินค้า</a><span>/</span><span aria-current="page">{product.shortName}</span></nav>
			<article class="product-layout">
				<div class="product-gallery">
					{product.gallery.map((item, index) => <img class={index === 0 ? 'product-hero' : 'product-detail'} src={imagePath(item.src)} width="800" height="800" alt={item.alt} loading={index === 0 ? undefined : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} />)}
				</div>
				<div class="product-copy">
					<p class="eyebrow">{product.category} · รุ่น {product.model}</p>
					<h1>{product.name}</h1>
					<p class="lead">{product.description}</p>
					<a class="button" href="/#contact">ขอใบเสนอราคาสำหรับรุ่น {product.model}</a>
					<section><h2>จุดเด่นของรุ่น {product.model}</h2><ul class="feature-list">{product.features.map((feature) => <li>{feature}</li>)}</ul></section>
					<section><h2>รายละเอียดเบื้องต้น</h2><dl class="spec-list"><div><dt>รุ่น</dt><dd>{product.model}</dd></div><div><dt>ประเภท</dt><dd>{product.category}</dd></div><div><dt>วัสดุ</dt><dd>{product.material}</dd></div><div><dt>การสั่งซื้อ</dt><dd>ติดต่อทีมขายเพื่อยืนยันสี จำนวน ราคา และรายละเอียดก่อนสั่งซื้อ</dd></div></dl></section>
					<section><h2>เหมาะกับใคร</h2><p>รุ่น {product.model} เหมาะสำหรับผู้ที่กำลังเปรียบเทียบ {product.category} เพื่อใช้งานในบ้าน หอพัก อพาร์ตเมนต์ ร้านค้า หรือโครงการ โดยควรแจ้งจำนวนและพื้นที่จัดส่งเพื่อให้ทีมขายแนะนำรายละเอียดที่ตรงกับงานของคุณ</p></section>
				</div>
			</article>
			{relatedProducts.length > 0 && <section class="related-products"><h2>สินค้าที่เกี่ยวข้อง</h2><div class="product-grid">{relatedProducts.map((item) => <article class="product-card"><img src={imagePath(item.image)} width="800" height="800" alt={item.gallery[0].alt} loading="lazy" /><div><p class="card-label">รุ่น {item.model}</p><h3>{item.shortName}</h3><p>{item.description}</p><a href={`/products/${item.slug}`}>ดูรายละเอียดสินค้า →</a></div></article>)}</div></section>}
		</main>
		<Footer />
	</body>
</html>
