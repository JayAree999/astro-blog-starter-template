---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { products } from '../../data/products';

export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const title = `${product.name} | Sunny Furniture`;
const productUrl = new URL(Astro.url.pathname, Astro.site).toString();
const productSchema = { '@context': 'https://schema.org', '@type': 'Product', name: product.name, description: product.description, image: product.gallery.map((item) => new URL(item.src, Astro.site).toString()), sku: product.model, brand: { '@type': 'Brand', name: 'Sunny Furniture' }, category: product.category, material: product.material, offers: { '@type': 'Offer', url: productUrl, priceCurrency: 'THB', availability: product.availability, itemCondition: 'https://schema.org/NewCondition', seller: { '@type': 'Organization', name: 'Deelert Woodline Co., Ltd.' } } };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: new URL('/', Astro.site).toString() }, { '@type': 'ListItem', position: 2, name: product.category, item: new URL('/#products', Astro.site).toString() }, { '@type': 'ListItem', position: 3, name: product.shortName, item: productUrl }] };
---
<!doctype html><html lang="th"><head><BaseHead title={title} description={product.description} image={product.image} type="product" /><script type="application/ld+json" set:html={JSON.stringify(productSchema)} /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} /></head><body><Header /><main class="product-page wrap"><nav class="breadcrumbs" aria-label="เส้นทางนำทาง"><a href="/">หน้าแรก</a><span>/</span><a href="/#products">{product.category}</a><span>/</span><span aria-current="page">{product.shortName}</span></nav><article class="product-layout"><div class="product-gallery"><img class="product-hero" src={product.image} width="800" height="800" alt={product.gallery[0].alt} fetchpriority="high" />{product.gallery[1] && <img class="product-detail" src={product.gallery[1].src} width="800" height="800" alt={product.gallery[1].alt} loading="lazy" />}</div><div class="product-copy"><p class="eyebrow">{product.category} · รุ่น {product.model}</p><h1>{product.name}</h1><p class="lead">{product.description}</p><a class="button" href="/#contact">ขอใบเสนอราคาสำหรับรุ่น {product.model}</a><section><h2>จุดเด่นสินค้า</h2><ul class="feature-list">{product.features.map((feature) => <li>{feature}</li>)}</ul></section><section><h2>รายละเอียดเบื้องต้น</h2><dl class="spec-list"><div><dt>รุ่น</dt><dd>{product.model}</dd></div><div><dt>ประเภท</dt><dd>{product.category}</dd></div><div><dt>วัสดุ</dt><dd>{product.material}</dd></div><div><dt>การสั่งซื้อ</dt><dd>ติดต่อทีมขายเพื่อยืนยันสี จำนวน และรายละเอียดก่อนสั่งซื้อ</dd></div></dl></section></div></article><section class="related-products"><h2>สินค้าที่เกี่ยวข้อง</h2><div class="product-grid">{products.filter((item) => item.slug !== product.slug).map((item) => <article class="product-card"><img src={item.image} width="800" height="800" alt={item.gallery[0].alt} loading="lazy" /><div><p class="card-label">รุ่น {item.model}</p><h3>{item.shortName}</h3><p>{item.description}</p><a href={`/products/${item.slug}`}>ดูรายละเอียดสินค้า →</a></div></article>)}</div></section></main><Footer /></body></html>
