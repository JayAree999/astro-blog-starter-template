---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { catalogProducts } from '../../data/catalog';

const title = 'ตู้เสื้อผ้า เตียงนอน และเฟอร์นิเจอร์ ราคาโรงงาน | Sunny Furniture';
const description = 'เลือกตู้เสื้อผ้า เตียงนอน ตู้วางทีวี ตู้รองเท้า และเฟอร์นิเจอร์ราคาโรงงานจาก Sunny Furniture สำหรับบ้าน หอพัก อพาร์ตเมนต์ ร้านค้า และโครงการ';
const familyFor = (model: string) => model.startsWith('D') ? 'wardrobe' : model.startsWith('B') ? 'bed' : 'other';
const labels = { all: 'สินค้าทั้งหมด', wardrobe: 'ตู้เสื้อผ้า', bed: 'เตียงนอน', other: 'เฟอร์นิเจอร์อื่น ๆ' };
const imagePath = (path: string) => path.replace(/\.png$/, '.webp');
---

<!doctype html>
<html lang="th">
	<head><BaseHead title={title} description={description} /></head>
	<body>
		<Header />
		<main>
			<section class="catalog-hero wrap">
				<p class="eyebrow">SUNNY FURNITURE · FACTORY CATALOG</p>
				<h1>เลือกเฟอร์นิเจอร์ให้ตรงกับพื้นที่และการใช้งาน</h1>
				<p class="lead">รวมตู้เสื้อผ้า เตียงนอน ตู้วางทีวี ตู้เก็บของ และเฟอร์นิเจอร์สำหรับบ้าน หอพัก อพาร์ตเมนต์ ร้านค้า และงานโครงการ</p>
				<div class="catalog-trust"><span>รูปสินค้าจากคลังจริง</span><span>สอบถามราคาโรงงานได้</span><span>รองรับงานขายส่งและ OEM</span></div>
			</section>

			<section class="catalog-download wrap" aria-label="ดาวน์โหลดแคตตาล็อก PDF">
				<div class="catalog-download-copy"><p class="eyebrow">CATALOG PDF</p><h2>ดูตัวอย่างและดาวน์โหลดแคตตาล็อก</h2><p>รวมภาพสินค้าและรายละเอียดจาก Sunny Furniture สำหรับเลือกสินค้าและสอบถามราคาขายส่ง</p><a class="button" href="/downloads/sunny-furniture-catalog.pdf" download>ดาวน์โหลดแคตตาล็อก PDF</a></div>
				<div class="catalog-preview" aria-label="ตัวอย่างหน้าจากแคตตาล็อก"><img src="/images/catalog-preview/page-1.jpg" width="800" height="1120" loading="lazy" alt="ตัวอย่างหน้าแรกของแคตตาล็อก Sunny Furniture" /><img src="/images/catalog-preview/page-2.jpg" width="800" height="1120" loading="lazy" alt="ตัวอย่างหน้าสินค้าในแคตตาล็อก Sunny Furniture" /><img src="/images/catalog-preview/page-3.jpg" width="800" height="1120" loading="lazy" alt="ตัวอย่างหน้าสินค้าในแคตตาล็อก Sunny Furniture" /></div>
			</section>

			<section class="catalog-controls wrap" aria-label="กรองสินค้า">
				<div><p class="eyebrow">BROWSE BY PRODUCT TYPE</p><h2>กรองตามประเภทสินค้า</h2></div>
				<div class="filter-buttons" role="group" aria-label="เลือกประเภทสินค้า">
					{Object.entries(labels).map(([key, label]) => <button type="button" class:list={['filter-button', { active: key === 'all' }]} data-filter={key}>{label}</button>)}
				</div>
			</section>

			<section class="catalog-results wrap" aria-live="polite">
				<p class="result-summary"><strong>{catalogProducts.length}</strong> รุ่นสินค้า · แสดงตู้เสื้อผ้า (D) ก่อน แล้วตามด้วยเตียงนอน (B)</p>
				<div class="product-grid catalog-grid">
					{catalogProducts.map((product) => (
						<article class="product-card catalog-card" data-family={familyFor(product.model)}>
							<img src={imagePath(product.image)} width="800" height="800" loading="lazy" alt={product.gallery[0].alt} />
							<div><p class="card-label">{familyFor(product.model) === 'wardrobe' ? 'ตู้เสื้อผ้า' : familyFor(product.model) === 'bed' ? 'เตียงนอน' : 'SUNNY FURNITURE'} · รุ่น {product.model}</p><h3>{product.shortName}</h3><p>{product.description}</p><a href={`/products/${product.slug}`}>ดูรายละเอียดสินค้า <span aria-hidden="true">→</span></a></div>
						</article>
					))}
				</div>
				<p class="empty-state" hidden>ไม่พบสินค้าในหมวดนี้ กรุณาเลือก “สินค้าทั้งหมด” เพื่อดูแคตตาล็อกทั้งหมด</p>
			</section>

			<section class="catalog-contact"><div class="wrap"><p class="eyebrow">WHOLESALE & PROJECTS</p><h2>ต้องการสั่งหลายรายการหรือผลิตตามแบบ?</h2><p>ส่งรุ่นสินค้า จำนวน และพื้นที่จัดส่งให้ทีมขาย เพื่อรับคำแนะนำและใบเสนอราคา</p><a class="button button-light" href="/#contact">ขอใบเสนอราคา</a></div></section>
		</main>
		<Footer />
		<script>
			const buttons = document.querySelectorAll('[data-filter]');
			const cards = document.querySelectorAll('[data-family]');
			const emptyState = document.querySelector('.empty-state');
			const applyFilter = (filter) => {
				let visible = 0;
				buttons.forEach((item) => item.classList.toggle('active', item.dataset.filter === filter));
				cards.forEach((card) => { const show = filter === 'all' || card.dataset.family === filter; card.toggleAttribute('hidden', !show); if (show) visible += 1; });
				emptyState?.toggleAttribute('hidden', visible !== 0);
			};
			buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter)));
			const requestedFilter = new URLSearchParams(window.location.search).get('filter');
			if (requestedFilter && [...buttons].some((button) => button.dataset.filter === requestedFilter)) applyFilter(requestedFilter);
		</script>
	</body>
</html>

<style>
	.catalog-hero{padding:5.75rem 0 3.5rem;background:linear-gradient(110deg,#edf4ef 0%,transparent 65%)}.catalog-hero h1{max-width:16ch}.catalog-hero .lead{max-width:62ch}.catalog-trust{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.6rem}.catalog-trust span{padding:.45rem .7rem;border-radius:99px;background:#fff;border:1px solid var(--line);font-size:.9rem;font-weight:700}.catalog-download{display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;gap:2.5rem;padding:2.5rem;margin-top:.5rem;background:linear-gradient(135deg,#e4f2f2,#f7f5ef);border:1px solid var(--line);border-radius:22px}.catalog-download h2{max-width:17ch;margin-bottom:.8rem}.catalog-download-copy p:not(.eyebrow){color:var(--muted);max-width:48ch}.catalog-preview{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;align-items:center}.catalog-preview img{width:100%;aspect-ratio:5/7;object-fit:cover;object-position:top;border-radius:10px;border:1px solid rgba(18,59,74,.14);box-shadow:0 10px 24px rgba(18,59,74,.12)}.catalog-preview img:nth-child(2){transform:translateY(.75rem)}.catalog-controls{display:flex;justify-content:space-between;align-items:end;gap:2rem;padding:2.25rem 0;border-bottom:1px solid var(--line)}.catalog-controls h2{margin:0;font-size:clamp(1.45rem,2.5vw,2rem)}.filter-buttons{display:flex;gap:.6rem;flex-wrap:wrap}.filter-button{border:1px solid var(--line);background:#fff;color:var(--ink);padding:.65rem .9rem;border-radius:99px;font:inherit;font-weight:700;cursor:pointer}.filter-button:hover,.filter-button.active{background:var(--brand);border-color:var(--brand);color:#fff}.catalog-results{padding:2.5rem 0 5rem}.result-summary{color:var(--muted)}.result-summary strong{color:var(--brand);font-size:1.15rem}.catalog-grid{grid-template-columns:repeat(3,minmax(0,1fr));margin-top:1.5rem}.catalog-card[hidden]{display:none}.catalog-card h3{font-size:1.13rem}.catalog-card p:not(.card-label){font-size:.94rem}.empty-state{padding:2rem;border:1px dashed var(--line);text-align:center;color:var(--muted)}.catalog-contact{padding:4.5rem 0;background:var(--brand-dark);color:#fff}.catalog-contact h2{max-width:26ch}.catalog-contact p:not(.eyebrow){max-width:56ch;color:#d4e0d8}@media(max-width:760px){.catalog-hero{padding:3.75rem 0 2.5rem}.catalog-download{grid-template-columns:1fr;padding:1.5rem;margin-top:0}.catalog-preview{max-width:520px}.catalog-controls{align-items:start;flex-direction:column;gap:1rem}.catalog-grid{grid-template-columns:1fr}.catalog-contact{padding:3.5rem 0}}
</style>
