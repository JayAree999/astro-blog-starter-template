---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const updates = [
	{ date: '4 August 2026', title: 'Catalog PDF preview and download added', items: ['Renamed the main catalog link to แคตตาล็อกและสินค้า.', 'Added a preview row above the product-type filters with three catalog pages and a direct PDF download.'] },
	{ date: '4 August 2026', title: 'Homepage product range simplified', items: ['Removed the Project Furniture card from the homepage product range at the owner’s request.'] },
	{ date: '4 August 2026', title: 'Homepage images and product galleries updated', items: ['Replaced the D6122 homepage image with the supplied solid-oak wardrobe image.', 'Changed the three bed cards to B5058, B5111, and B5112.', 'Each product page now displays every local product image available for that model.', 'Removed unwanted supplier labels from catalog content shown on web pages.'] },
	{ date: '4 August 2026', title: 'Homepage product imagery refreshed', items: ['Replaced the previous D4901 black-oak image with a four-image product showcase.', 'Added D6122 and D6123 wardrobes plus B5009 and B5009-2 beds from the local catalog.', 'Restricted the new hero selection to solid-oak finishes and optimized WebP images.', 'Updated the site-wide sharing and fallback image to D6122.'] },
	{ date: '4 สิงหาคม 2026', title: 'ปรับปรุงแคตตาล็อก การค้นหา และประสบการณ์ใช้งาน', items: ['เปลี่ยนจากลิงก์หมวดที่พาไปหน้าคู่มือ เป็นตัวกรองสินค้าในแคตตาล็อกจริง', 'ตัวกรองตู้เสื้อผ้าแสดงเฉพาะรุ่นรหัส D และตัวกรองเตียงนอนแสดงเฉพาะรุ่นรหัส B', 'เพิ่มเมนูนำทางตรงไปยังแคตตาล็อก ตู้เสื้อผ้า เตียงนอน งาน OEM และใบเสนอราคา', 'ปรับหน้าแรกให้มีเส้นทางเลือกสินค้าและคำค้นหลักสำหรับลูกค้าไทย เช่น ตู้เสื้อผ้า เตียงนอน และเฟอร์นิเจอร์ราคาโรงงาน', 'ปรับลำดับการแสดงผลให้ตู้เสื้อผ้ามาก่อน เตียงนอนตามลำดับ แล้วจึงเป็นสินค้าอื่น'] },
	{ date: '4 สิงหาคม 2026', title: 'ตรวจสอบการรวบรวมข้อมูลสำหรับ Google', items: ['ตรวจสอบ URL ใน sitemap จำนวน 126 หน้า ทุกหน้าตอบกลับสำเร็จและมี title กับ description', 'นำหน้าสินค้าที่มีรูปอย่างเดียวและกำหนด noindex ออกจาก sitemap เพื่อไม่ให้สัญญาณ SEO ขัดแย้งกัน', 'คงหน้าสินค้าที่มีรายละเอียดตรวจสอบได้ไว้สำหรับการจัดทำดัชนี', 'ปรับ title และ description ของหน้าแรกและหน้าแคตตาล็อกให้ครอบคลุมคำค้นตู้เสื้อผ้า เตียงนอน ตู้วางทีวี ตู้เก็บของ และเฟอร์นิเจอร์ราคาโรงงาน'] },
	{ date: '4 สิงหาคม 2026', title: 'นำเข้ารูปภาพและรุ่นสินค้าจาก Furniture pics raw', items: ['นำเข้าสินค้า 120 รุ่น พร้อมภาพ WebP ที่ปรับให้เหมาะกับการแสดงผลบนเว็บไซต์', 'ใช้ภาพสินค้าจากคลังภายในแทนการดาวน์โหลดจาก Dropbox', 'รุ่นที่มีข้อมูลสินค้าตรวจสอบได้สามารถให้ Google จัดทำดัชนี ส่วนรุ่นที่มีเพียงภาพยังคง noindex จนกว่าจะมีรายละเอียด'] },
	{ date: '4 สิงหาคม 2026', title: 'ย้ายแคตตาล็อกไปยัง catalog.sunny.co.th', items: ['อัปเดต canonical URL, schema, robots.txt และ sitemap ให้ใช้โดเมน catalog.sunny.co.th', 'ส่ง sitemap ไปยัง Google Search Console', 'เพิ่มหน้าคู่มือเลือกซื้อสำหรับตู้เสื้อผ้า เตียงนอน ตู้วางทีวี และตู้เก็บของ/ตู้รองเท้า'] },
];
---

<!doctype html><html lang="th"><head><BaseHead title="บันทึกการอัปเดตเว็บไซต์ | Sunny Furniture" description="บันทึกการอัปเดตแคตตาล็อก การออกแบบ และ SEO ของ Sunny Furniture" robots="noindex,follow" /></head><body><Header /><main class="updates-page wrap"><p class="eyebrow">SITE UPDATE LOG</p><h1>บันทึกการอัปเดตเว็บไซต์</h1><p class="lead">สรุปสิ่งที่เพิ่มและปรับปรุงในแต่ละครั้ง เพื่อให้ติดตามแคตตาล็อก เนื้อหา และการทำ SEO ได้ง่าย</p>{updates.map((update) => <article class="update-entry"><p class="card-label">{update.date}</p><h2>{update.title}</h2><ul>{update.items.map((item) => <li>{item}</li>)}</ul></article>)}</main><Footer /></body></html>

<style>.updates-page{padding:5rem 0}.updates-page .lead{max-width:65ch}.update-entry{max-width:820px;margin-top:2rem;padding:2rem;background:var(--surface);border:1px solid var(--line);border-radius:12px}.update-entry h2{font-size:1.35rem}.update-entry ul{padding-left:1.2rem}.update-entry li{margin:.7rem 0}@media(max-width:760px){.updates-page{padding:3.5rem 0}.update-entry{padding:1.35rem}}</style>
